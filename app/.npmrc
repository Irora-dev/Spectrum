# Where packages come from is a security decision, so it is written down here
# rather than inherited from whatever environment runs the install (security
# queue item 3, 2026-08-07). `scripts/dep-integrity.mjs` asserts this line.
registry=https://registry.npmjs.org/

# Refuse to install anything the lockfile does not already pin. `npm ci` does
# this by definition; this makes a plain `npm install` fail loudly instead of
# quietly resolving a new version — the lockfile IS the chain of custody.
engine-strict=true

# NOTE ON `ignore-scripts`: deliberately NOT set. esbuild's postinstall links
# the platform binary it fundamentally is, so a blanket ban breaks the build
# and would be switched off within a day — the same failure mode as a CSP that
# breaks the app. The enforced control is an ALLOWLIST instead: every package
# permitted to run code at install is named, with its reason and its exact
# script text, in scripts/dep-integrity.mjs. A new one fails the check.
