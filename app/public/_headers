# Firefox one-click install needs the xpinstall MIME type. Netlify supports
# only whole-segment splats (no *.xpi globs), so the packaging step places the
# signed file under /extension/xpi/ where a trailing splat can reach it.
# (The Vercel equivalent lives in vercel.json "headers".)
/extension/xpi/*
  Content-Type: application/x-xpinstall
