{
  "name": "spectrum-fe",
  "private": true,
  "license": "CC0-1.0",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "init:env": "node scripts/init-env.mjs",
    "bake:colors": "node scripts/bake-token-meta.mjs",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "build:tokenlist": "node scripts/build-tokenlist.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:deps": "node scripts/dep-integrity.mjs",
    "check:secrets": "node scripts/no-client-secrets.mjs",
    "verify:chain": "node ../create/verify.mjs",
    "smoke:sacred": "vitest run --mode sacred src/sacred-smoke.live.test.ts",
    "smoke:console": "node scripts/console-smoke.mjs",
    "chat:drive": "node scripts/chat-drive/build-agent.mjs && node scripts/chat-drive/drive.mjs",
    "chat:drive:fast": "node scripts/chat-drive/build-agent.mjs && DRIVE_FAST=1 node scripts/chat-drive/drive.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "rehearse:4663": "vitest run --mode rehearsal src/rehearsal-4663.live.test.ts",
    "verify:deployment": "vitest run --mode verify src/verify-deployment.live.test.ts",
    "update:site": "node ../create/update.mjs",
    "doctor": "node scripts/doctor.mjs",
    "mcp:build": "node ../mcp/build.mjs",
    "mcp:test": "node ../mcp/build.mjs && node --test ../mcp/server.test.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "prebuild": "node scripts/rehearsal-tripwire.mjs && node scripts/emit-headers.mjs && node scripts/check-config.mjs && node scripts/build-sitemap.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/release-manifest.mjs && node scripts/no-client-secrets.mjs",
    "package": "npm run build && node scripts/package-site.mjs",
    "package:only": "node scripts/package-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:mutation": "stryker run && node scripts/mutation-floors.mjs",
    "verify:deployments": "node scripts/verify-deployments.mjs",
    "og:cards": "node scripts/build-og-cards.mjs",
    "lint": "eslint src",
    "shadow:pass": "vitest run --mode shadow src/shadow.live.test.ts",
    "mutation:floors": "node scripts/mutation-floors.mjs",
    "absorb:verify": "cd .. && node app/scripts/absorb-verify.mjs --guard attrEscape --guard finiteUsd --guard confirmSignableAmount --guard shownFloorMismatch"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.77",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "viem": "^2.21.0",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jimp": "^1.6.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
