{
  "name": "spectrum-extension",
  "private": true,
  "license": "CC0-1.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:all": "npm run build && npm run build:firefox",
    "package": "node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "publish:chrome": "node scripts/publish-chrome.mjs",
    "status": "node scripts/status.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.280",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright-core": "^1.49.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
